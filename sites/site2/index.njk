---
layout: base.njk
title: ""
permalink: "/index.html"
---
<section class="hero">
  <span class="eyebrow">Guides · Tutorials · Inspiration</span>
  <h1>{{ site.site_name }}</h1>
  <p>{{ site.site_description }}</p>
</section>

{% set posts = collections.posts %}
{% if posts.length %}
  {% set featured = posts[0] %}
  <a class="featured" href="{{ featured.url }}">
    {% if featured.data.image %}<img src="{{ featured.data.image }}" alt="{{ featured.data.image_alt or featured.data.title }}" loading="lazy">{% endif %}
    <div class="featured-body">
      <span class="eyebrow">Latest</span>
      <h2>{{ featured.data.title }}</h2>
      <p>{{ featured.data.excerpt }}</p>
      <span class="meta">{{ featured.date | readableDate }} · Read article →</span>
    </div>
  </a>

  {% if posts.length > 1 %}
  <h2 class="section-title">More articles</h2>
  <div class="post-grid">
    {% for post in posts.slice(1) %}
    <div class="post-card">
      {% if post.data.image %}
      <a class="thumb" href="{{ post.url }}"><img src="{{ post.data.image }}" alt="{{ post.data.image_alt or post.data.title }}" loading="lazy"></a>
      {% endif %}
      <div class="body">
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p class="excerpt">{{ post.data.excerpt }}</p>
        <div class="meta"><span>{{ post.date | readableDate }}</span><a class="read-more" href="{{ post.url }}">Read →</a></div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}
{% else %}
  <p style="text-align:center;color:var(--muted);">New articles are on the way — check back soon!</p>
{% endif %}

<style>
  .featured {
    display: grid; grid-template-columns: 1.15fr 1fr; gap: 0; margin-bottom: 44px;
    background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius);
    overflow: hidden; box-shadow: var(--shadow); text-decoration: none; color: var(--text);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .featured:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .featured img { width: 100%; height: 100%; min-height: 260px; object-fit: cover; display: block; }
  .featured-body { padding: 30px; display: flex; flex-direction: column; justify-content: center; }
  .featured-body h2 { font-family: var(--serif); font-weight: 700; font-size: 1.7rem; line-height: 1.18; letter-spacing: -.02em; margin: 10px 0 12px; }
  .featured-body p { color: var(--muted); margin: 0 0 16px; }
  .featured-body .meta { color: var(--accent); font-weight: 600; font-size: .9rem; }
  @media (max-width: 720px) {
    .featured { grid-template-columns: 1fr; }
    .featured img { min-height: 200px; aspect-ratio: 16/10; }
  }
</style>
