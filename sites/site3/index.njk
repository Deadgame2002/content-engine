---
layout: base.njk
title: ""
permalink: "/index.html"
---
<h1 style="margin-bottom:24px;">Latest posts</h1>

{% for post in collections.posts %}
<div class="post-card">
  {% if post.data.image %}
  <a href="{{ post.url }}"><img src="{{ post.data.image }}" alt="{{ post.data.image_alt or post.data.title }}" loading="lazy"></a>
  {% endif %}
  <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  <p class="excerpt">{{ post.data.excerpt }}</p>
  <p class="meta">{{ post.data.date | isoDate }}</p>
</div>
{% endfor %}
