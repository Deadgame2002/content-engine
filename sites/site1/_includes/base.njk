<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Ezoic Privacy Scripts - must load first -->
  <script data-cfasync="false" src="https://cmp.gatekeeperconsent.com/min.js"></script>
  <script data-cfasync="false" src="https://the.gatekeeperconsent.com/cmp.min.js"></script>

  <!-- Ezoic Header Script -->
  <script async src="//www.ezojs.com/ezoic/sa.min.js"></script>
  <script>
    window.ezstandalone = window.ezstandalone || {};
    ezstandalone.cmd = ezstandalone.cmd || [];
  </script>
  <script src="//ezoicanalytics.com/analytics.js"></script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or site.site_name }}{% if title %} | {{ site.site_name }}{% endif %}</title>
  <meta name="description" content="{{ meta_description or excerpt or site.site_description }}">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="theme-color" content="#c8694f">
  <link rel="canonical" href="{{ site.base_url }}{{ page.url }}">

  <!-- Open Graph -->
  <meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
  <meta property="og:site_name" content="{{ site.site_name }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:title" content="{{ title or site.site_name }}">
  <meta property="og:description" content="{{ meta_description or excerpt or site.site_description }}">
  <meta property="og:url" content="{{ site.base_url }}{{ page.url }}">
  {% if image %}<meta property="og:image" content="{{ image }}">
  <meta property="og:image:alt" content="{{ image_alt or title }}">{% endif %}
  {% if layout == 'post.njk' %}
  <meta property="article:published_time" content="{{ date | isoDate }}">
  <meta property="article:modified_time" content="{{ date | isoDate }}">
  {% for kw in keywords %}<meta property="article:tag" content="{{ kw }}">
  {% endfor %}{% endif %}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.site_name }}">
  <meta name="twitter:description" content="{{ meta_description or excerpt or site.site_description }}">
  {% if image %}<meta name="twitter:image" content="{{ image }}">{% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://i.ibb.co">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%E2%9C%92%EF%B8%8F%3C/text%3E%3C/svg%3E">

  <!-- Site structured data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "{{ site.base_url }}/#website",
        "url": "{{ site.base_url }}/",
        "name": {{ site.site_name | dump | safe }},
        "description": {{ site.site_description | dump | safe }},
        "publisher": { "@id": "{{ site.base_url }}/#organization" }
      },
      {
        "@type": "Organization",
        "@id": "{{ site.base_url }}/#organization",
        "name": {{ site.site_name | dump | safe }},
        "url": "{{ site.base_url }}/"
      }
    ]
  }
  </script>

  <style>
    :root {
      --bg: #fbf9f6;
      --bg-soft: #f4efe8;
      --text: #26221e;
      --muted: #6f675e;
      --accent: #c8694f;
      --accent-dark: #a84f38;
      --accent-soft: #fbeee7;
      --card-bg: #ffffff;
      --border: #ece5db;
      --shadow: 0 1px 2px rgba(38,34,30,.04), 0 8px 24px rgba(38,34,30,.06);
      --shadow-lg: 0 4px 12px rgba(38,34,30,.08), 0 20px 48px rgba(38,34,30,.10);
      --radius: 16px;
      --max: 760px;
      --wide: 1120px;
      --serif: "Fraunces", Georgia, "Times New Roman", serif;
      --sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #1a1714; --bg-soft: #221e19; --text: #ece6df; --muted: #a89f94;
        --accent: #e8a189; --accent-dark: #f0b7a3; --accent-soft: #2c2420;
        --card-bg: #221e19; --border: #362f28;
        --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px rgba(0,0,0,.35);
        --shadow-lg: 0 4px 12px rgba(0,0,0,.4), 0 20px 48px rgba(0,0,0,.5);
      }
    }
    :root[data-theme="dark"] {
      --bg: #1a1714; --bg-soft: #221e19; --text: #ece6df; --muted: #a89f94;
      --accent: #e8a189; --accent-dark: #f0b7a3; --accent-soft: #2c2420;
      --card-bg: #221e19; --border: #362f28;
      --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px rgba(0,0,0,.35);
      --shadow-lg: 0 4px 12px rgba(0,0,0,.4), 0 20px 48px rgba(0,0,0,.5);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0; background: var(--bg); color: var(--text);
      font-family: var(--sans); line-height: 1.7; font-size: 18px;
      -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
    }
    .wrap { max-width: var(--max); margin: 0 auto; padding: 0 20px; }

    /* Header */
    header.site-header {
      position: sticky; top: 0; z-index: 50;
      background: color-mix(in srgb, var(--card-bg) 82%, transparent);
      backdrop-filter: saturate(160%) blur(12px);
      -webkit-backdrop-filter: saturate(160%) blur(12px);
      border-bottom: 1px solid var(--border);
    }
    .site-nav {
      display: flex; justify-content: space-between; align-items: center;
      max-width: var(--wide); margin: 0 auto; padding: 14px 20px; gap: 16px;
    }
    .site-nav .logo {
      color: var(--text); text-decoration: none; font-family: var(--serif);
      font-weight: 700; font-size: 1.25rem; letter-spacing: -.01em;
      display: inline-flex; align-items: center; gap: 8px;
    }
    .site-nav .logo .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
    .site-nav .links { display: flex; align-items: center; gap: 4px; }
    .site-nav .links a {
      color: var(--muted); text-decoration: none; font-size: .92rem; font-weight: 500;
      padding: 8px 12px; border-radius: 8px; transition: color .15s, background .15s;
    }
    .site-nav .links a:hover { color: var(--accent); background: var(--accent-soft); }
    .theme-toggle {
      background: transparent; border: 1px solid var(--border); color: var(--muted);
      width: 38px; height: 38px; border-radius: 10px; cursor: pointer; font-size: 1rem;
      display: inline-flex; align-items: center; justify-content: center; transition: .15s;
    }
    .theme-toggle:hover { color: var(--accent); border-color: var(--accent); }

    main { max-width: var(--max); margin: 0 auto; padding: 44px 20px 88px; }

    /* Hero (home) */
    .hero { text-align: center; padding: 56px 0 40px; }
    .hero .eyebrow {
      display: inline-block; font-size: .78rem; font-weight: 600; letter-spacing: .08em;
      text-transform: uppercase; color: var(--accent); background: var(--accent-soft);
      padding: 6px 14px; border-radius: 999px; margin-bottom: 18px;
    }
    .hero h1 {
      font-family: var(--serif); font-weight: 700; font-size: clamp(2rem, 5vw, 3.1rem);
      line-height: 1.08; letter-spacing: -.025em; margin: 0 0 16px;
    }
    .hero p { color: var(--muted); font-size: 1.12rem; max-width: 560px; margin: 0 auto; }

    .section-title {
      font-family: var(--serif); font-weight: 600; font-size: 1.5rem; letter-spacing: -.02em;
      margin: 8px 0 24px; display: flex; align-items: center; gap: 12px;
    }
    .section-title::after { content: ""; flex: 1; height: 1px; background: var(--border); }

    /* Post cards grid */
    .post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
    .post-card {
      background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius);
      overflow: hidden; box-shadow: var(--shadow); transition: transform .2s ease, box-shadow .2s ease;
      display: flex; flex-direction: column;
    }
    .post-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
    .post-card .thumb { display: block; overflow: hidden; aspect-ratio: 16 / 10; background: var(--bg-soft); }
    .post-card .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
    .post-card:hover .thumb img { transform: scale(1.05); }
    .post-card .body { padding: 20px 20px 22px; display: flex; flex-direction: column; flex: 1; }
    .post-card h2 { font-family: var(--serif); margin: 0 0 8px; font-size: 1.2rem; line-height: 1.28; letter-spacing: -.01em; }
    .post-card h2 a { color: var(--text); text-decoration: none; }
    .post-card h2 a:hover { color: var(--accent); }
    .post-card p.excerpt { color: var(--muted); margin: 0 0 16px; font-size: .95rem; flex: 1; }
    .post-card .meta { color: var(--muted); font-size: .82rem; display: flex; gap: 10px; align-items: center; }
    .post-card .meta .read-more { margin-left: auto; color: var(--accent); font-weight: 600; }

    /* Article */
    article { font-size: 1.06rem; }
    article img { border-radius: var(--radius); box-shadow: var(--shadow); }
    article img.cover { width: 100%; margin-bottom: 8px; aspect-ratio: 16 / 9; object-fit: cover; }
    article h1 {
      font-family: var(--serif); font-weight: 700; font-size: clamp(1.9rem, 4.5vw, 2.7rem);
      line-height: 1.12; letter-spacing: -.025em; margin: 20px 0 14px;
    }
    article h2 { font-family: var(--serif); font-weight: 600; font-size: 1.6rem; letter-spacing: -.02em; margin: 2.6rem 0 .8rem; scroll-margin-top: 80px; }
    article h3 { font-family: var(--serif); font-weight: 600; font-size: 1.25rem; margin: 1.8rem 0 .6rem; scroll-margin-top: 80px; }
    article p { margin: 0 0 1.25rem; }
    article ul, article ol { margin: 0 0 1.25rem; padding-left: 1.35rem; }
    article li { margin-bottom: .5rem; }
    article a { color: var(--accent); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent); text-underline-offset: 2px; }
    article a:hover { color: var(--accent-dark); text-decoration-color: var(--accent); }
    article blockquote {
      margin: 1.6rem 0; padding: 4px 20px; border-left: 4px solid var(--accent);
      background: var(--accent-soft); border-radius: 0 10px 10px 0; color: var(--text);
    }
    article strong { color: var(--text); }
    article table {
      width: 100%; border-collapse: collapse; margin: 1.8rem 0; font-size: .95rem;
      border: 1px solid var(--border); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow);
    }
    article th { background: var(--bg-soft); padding: 12px 14px; text-align: left; font-weight: 600; }
    article td { padding: 11px 14px; border-top: 1px solid var(--border); }
    article tbody tr:nth-child(even), article tr:nth-child(even) { background: color-mix(in srgb, var(--bg-soft) 45%, transparent); }
    article hr { border: none; border-top: 1px solid var(--border); margin: 2.5rem 0; }

    /* Breadcrumb + byline */
    .breadcrumb { font-size: .85rem; color: var(--muted); margin-bottom: 18px; }
    .breadcrumb a { color: var(--muted); text-decoration: none; }
    .breadcrumb a:hover { color: var(--accent); }
    .byline {
      display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px;
      color: var(--muted); font-size: .9rem; margin: 0 0 26px; padding-bottom: 20px;
      border-bottom: 1px solid var(--border);
    }
    .byline .chip { display: inline-flex; align-items: center; gap: 6px; }

    /* Tags */
    .tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 32px 0 0; }
    .tags .tag { font-size: .8rem; color: var(--muted); background: var(--bg-soft); border: 1px solid var(--border); padding: 5px 12px; border-radius: 999px; }

    /* CTA */
    .cta-box {
      margin-top: 40px; padding: 26px; border-radius: var(--radius);
      background: linear-gradient(135deg, var(--accent-soft), color-mix(in srgb, var(--accent-soft) 60%, var(--card-bg)));
      border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--border));
    }
    .cta-box strong { font-family: var(--serif); font-size: 1.2rem; font-weight: 600; }
    .cta-box a.btn {
      display: inline-block; margin-top: 14px; background: var(--accent); color: #fff;
      padding: 12px 22px; border-radius: 10px; text-decoration: none; font-weight: 600;
      box-shadow: 0 6px 16px color-mix(in srgb, var(--accent) 40%, transparent); transition: .18s;
    }
    .cta-box a.btn:hover { background: var(--accent-dark); transform: translateY(-2px); }
    .cf-banner img { max-width: 100%; border-radius: 10px; display: block; margin: 8px 0; box-shadow: var(--shadow); }
    .cf-banners-block { margin: 2.5rem 0; }

    /* Related */
    .related { margin-top: 56px; padding-top: 8px; }

    /* Footer */
    footer.site-footer {
      background: var(--bg-soft); border-top: 1px solid var(--border);
      color: var(--muted); font-size: .9rem; margin-top: 40px;
    }
    footer.site-footer .inner { max-width: var(--wide); margin: 0 auto; padding: 40px 20px; text-align: center; }
    footer.site-footer .brand { font-family: var(--serif); font-weight: 700; font-size: 1.15rem; color: var(--text); margin-bottom: 10px; }
    footer.site-footer .footer-links { margin: 14px 0; }
    footer.site-footer .footer-links a { color: var(--muted); text-decoration: none; margin: 0 10px; }
    footer.site-footer .footer-links a:hover { color: var(--accent); }
    footer.site-footer .copyright { font-size: .82rem; opacity: .85; margin-top: 8px; }

    @media (max-width: 640px) {
      body { font-size: 17px; }
      .site-nav .links a { padding: 8px 8px; font-size: .88rem; }
    }
  </style>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5057566687364986"
     crossorigin="anonymous"></script>
</head>
<body>
  <header class="site-header">
    <nav class="site-nav">
      <a class="logo" href="/"><span class="dot"></span>{{ site.site_name }}</a>
      <span class="links">
        <a href="/">Home</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode" onclick="__toggleTheme()">🌙</button>
      </span>
    </nav>
  </header>
  <main>
    <script>
      ezstandalone.cmd.push(function () {
        ezstandalone.showAds({});
      });
    </script>
    {{ content | safe }}
    <script>
      ezstandalone.cmd.push(function () {
        ezstandalone.showAds({});
      });
    </script>
  </main>
  <footer class="site-footer">
    <div class="inner">
      <div class="brand">{{ site.site_name }}</div>
      <p style="max-width:460px;margin:0 auto;">{{ site.site_description }}</p>
      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
      </div>
      <div class="copyright">&copy; {{ site.currentYear }} {{ site.site_name }}. All rights reserved.</div>
    </div>
  </footer>
  <script>
    function __applyTheme(t){var r=document.documentElement;if(t==="dark"||t==="light"){r.setAttribute("data-theme",t);}else{r.removeAttribute("data-theme");}var b=document.querySelector(".theme-toggle");if(b){var dark=t==="dark"||(t!=="light"&&window.matchMedia("(prefers-color-scheme: dark)").matches);b.textContent=dark?"☀️":"🌙";}}
    function __toggleTheme(){var r=document.documentElement;var cur=r.getAttribute("data-theme");var next=(cur==="dark"||(!cur&&window.matchMedia("(prefers-color-scheme: dark)").matches))?"light":"dark";localStorage.setItem("theme",next);__applyTheme(next);}
    __applyTheme(localStorage.getItem("theme")||"auto");
  </script>
</body>
</html>
