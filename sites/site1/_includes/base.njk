<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "Blog" }}{% if title %} | {{ site.site_name }}{% endif %}</title>
  <meta name="description" content="{{ meta_description or excerpt or site.site_description }}">
  <link rel="canonical" href="{{ site.base_url }}{{ page.url }}">
  <meta property="og:type" content="{% if title %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ title or site.site_name }}">
  <meta property="og:description" content="{{ meta_description or excerpt or site.site_description }}">
  <meta property="og:url" content="{{ site.base_url }}{{ page.url }}">
  {% if image %}<meta property="og:image" content="{{ image }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.site_name }}">
  <meta name="twitter:description" content="{{ meta_description or excerpt or site.site_description }}">
  {% if image %}<meta name="twitter:image" content="{{ image }}">{% endif %}
  <style>
    :root {
      --bg: #faf8f5; --text: #2b2b2b; --muted: #6b6b6b;
      --accent: #c8694f; --card-bg: #ffffff; --border: #ece6df; --max: 780px;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; line-height: 1.65; }
    header.site-header { padding: 20px; border-bottom: 1px solid var(--border); background: var(--card-bg); }
    .site-nav { display: flex; justify-content: space-between; align-items: center; max-width: var(--max); margin: 0 auto; }
    .site-nav .logo { color: var(--text); text-decoration: none; font-weight: 700; font-size: 1.2rem; }
    .site-nav .links a { color: var(--muted); text-decoration: none; font-size: 0.9rem; margin-left: 16px; }
    .site-nav .links a:hover { color: var(--accent); }
    main { max-width: var(--max); margin: 0 auto; padding: 32px 20px 80px; }
    .post-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 14px; padding: 20px; margin-bottom: 20px; }
    .post-card img { width: 100%; border-radius: 10px; display: block; margin-bottom: 14px; }
    .post-card h2 { margin: 0 0 8px; font-size: 1.2rem; }
    .post-card h2 a { color: var(--text); text-decoration: none; }
    .post-card h2 a:hover { color: var(--accent); }
    .post-card p.excerpt { color: var(--muted); margin: 0 0 10px; font-size: 0.95rem; }
    .meta { color: var(--muted); font-size: 0.85rem; }
    article img.cover { width: 100%; border-radius: 14px; margin-bottom: 24px; }
    article h1 { font-size: 1.8rem; letter-spacing: -0.02em; margin-bottom: 6px; }
    article h2 { font-size: 1.35rem; margin-top: 2rem; }
    article h3 { font-size: 1.1rem; margin-top: 1.5rem; }
    article a { color: var(--accent); }
    article table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.9rem; }
    article th { background: var(--border); padding: 10px 12px; text-align: left; }
    article td { padding: 9px 12px; border-bottom: 1px solid var(--border); }
    .cta-box { margin-top: 36px; padding: 20px; border-radius: 14px; background: #fff3ee; border: 1px solid #f1d8cc; }
    .cta-box a { display: inline-block; margin-top: 8px; background: var(--accent); color: #fff; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 600; }
    .cf-banner img { max-width: 100%; border-radius: 8px; display: block; margin: 8px 0; }
    .cf-banners-block { margin: 2rem 0; }
    footer { text-align: center; color: var(--muted); font-size: 0.8rem; padding: 30px 20px; border-top: 1px solid var(--border); }
    footer .footer-links { margin-top: 8px; }
    footer .footer-links a { color: var(--muted); text-decoration: none; margin: 0 8px; }
    footer .footer-links a:hover { color: var(--accent); }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="site-nav">
      <a class="logo" href="/">{{ site.site_name }}</a>
      <span class="links">
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
      </span>
    </div>
  </header>
  <main>{{ content | safe }}</main>
  <footer>
    &copy; {{ site.currentYear }} {{ site.site_name }}
    <div class="footer-links">
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy-policy/">Privacy Policy</a>
      <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
    </div>
  </footer>
</body>
</html>
